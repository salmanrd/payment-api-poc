@page "/payments-ui/{paymentReference}"
@model PaymentApi.Pages.Payments.DetailsModel
@{
    ViewData["Title"] = "Payment details";
}

@if (Model.Payment is not null)
{
    <a asp-page="/Cases/Details" asp-route-ccdCaseNumber="@Model.Payment.CcdCaseNumber" class="back-link">Back to payments</a>
}
else
{
    <a asp-page="/Payments/Index" class="back-link">Back to payments</a>
}
<h1>Payment details</h1>

@if (Model.LoadFailed)
{
    <div class="message message-error" role="alert"><h2>Payment could not be loaded</h2><p>Try again later.</p></div>
}
else if (Model.Payment is null)
{
    <div class="message" role="alert"><h2>Payment not found</h2><p>Check the payment reference and try again.</p></div>
}
else
{
    var payment = Model.Payment;
    <dl class="summary-list">
        <div><dt>Payment reference</dt><dd>@payment.PaymentReference</dd></div>
        <div><dt>Status</dt><dd><span class="status status-@payment.Status.ToLowerInvariant()">@payment.Status</span></dd></div>
        <div><dt>Amount</dt><dd>@payment.Amount.ToString("N2")</dd></div>
        <div><dt>Currency</dt><dd>@payment.Currency</dd></div>
        <div><dt>Service request reference</dt><dd>@payment.ServiceRequestReference</dd></div>
        @if (!string.IsNullOrWhiteSpace(payment.CaseReference))
        {
            <div><dt>Case reference</dt><dd>@payment.CaseReference</dd></div>
        }
        <div><dt>CCD case number</dt><dd>@payment.CcdCaseNumber</dd></div>
        <div><dt>Date created</dt><dd><time datetime="@payment.DateCreated.ToString("O")">@payment.DateCreated.ToString("d MMMM yyyy 'at' HH:mm")</time></dd></div>
    </dl>
}
