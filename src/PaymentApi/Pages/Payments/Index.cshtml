@page "/payments-ui"
@model PaymentApi.Pages.Payments.IndexModel
@{
    ViewData["Title"] = "Payments";
}

<h1>Payments</h1>

<form method="get" class="filters" role="search">
    <div class="form-group search-group">
        <label for="search">Search payments</label>
        <div class="search-row">
            <input id="search" name="search" value="@Model.Search" type="search" />
            <button type="submit">Search</button>
        </div>
        <div class="hint">Search by payment, service request, case or CCD case reference</div>
    </div>
    <div class="form-group status-group">
        <label for="status">Status</label>
        <select id="status" name="status">
            <option value="">All</option>
            @foreach (var status in new[] { "Initiated", "Success", "Failed", "Cancelled" })
            {
                <option value="@status" selected="@(Model.Status == status)">@status</option>
            }
        </select>
    </div>
</form>

@if (Model.LoadFailed)
{
    <div class="message message-error" role="alert">
        <h2>Payments could not be loaded</h2>
        <p>Try again later.</p>
    </div>
}
else if (Model.Payments.Count == 0)
{
    <div class="message">
        <h2>No payments found</h2>
        <p>Try changing your search or status filter.</p>
    </div>
}
else
{
    <div class="table-scroll">
        <table>
            <caption class="visually-hidden">Payments matching the selected filters</caption>
            <thead><tr>
                <th scope="col">Payment reference</th>
                <th scope="col">Service request</th>
                <th scope="col">Case reference</th>
                <th scope="col" class="numeric">Amount</th>
                <th scope="col">Currency</th>
                <th scope="col">Status</th>
                <th scope="col">Date created</th>
            </tr></thead>
            <tbody>
            @foreach (var payment in Model.Payments)
            {
                <tr>
                    <td><a asp-page="/Payments/Details" asp-route-paymentReference="@payment.PaymentReference">@payment.PaymentReference</a></td>
                    <td>@payment.ServiceRequestReference</td>
                    <td>@(payment.CaseReference ?? "—")</td>
                    <td class="numeric">@payment.Amount.ToString("N2")</td>
                    <td>@payment.Currency</td>
                    <td><span class="status status-@payment.Status.ToLowerInvariant()">@payment.Status</span></td>
                    <td><time datetime="@payment.DateCreated.ToString("O")">@payment.DateCreated.ToString("d MMM yyyy")</time></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
