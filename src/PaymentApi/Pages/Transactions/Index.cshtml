@page "/transactions"
@model PaymentApi.Pages.Transactions.IndexModel
@{
    ViewData["Title"] = "Transactions";
}

<h1>Transactions</h1>

<form method="get" class="filters" role="search">
    <div class="form-group search-group">
        <label asp-for="CaseNo">Search by case number</label>
        <div class="search-row">
            <input asp-for="CaseNo" type="search" />
            <button type="submit">Search</button>
        </div>
        <div class="hint">Enter all or part of a case number or CCD case number</div>
    </div>
</form>

<section class="transaction-section" aria-labelledby="transactions-heading">
    <h2 id="transactions-heading">Transaction data</h2>
    @if (Model.Transactions.Count == 0)
    {
        <p>No transactions found.</p>
    }
    else
    {
        <div class="transaction-list">
        @foreach (var transaction in Model.Transactions)
        {
            <article class="transaction-card">
                <h3>Transaction @transaction.TransactionId</h3>
                <dl class="transaction-details">
                    <div><dt>Case number</dt><dd>@transaction.CaseNo</dd></div>
                    <div><dt>CCD case number</dt><dd>@transaction.CcdCaseNumber</dd></div>
                    <div><dt>Type</dt><dd>@transaction.TransactionType</dd></div>
                    <div><dt>Method</dt><dd>@transaction.TransactionMethod</dd></div>
                    <div><dt>Date</dt><dd>@transaction.TransactionDate.ToString("dd MMM yyyy HH:mm")</dd></div>
                    <div><dt>Amount</dt><dd>@transaction.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-GB"))</dd></div>
                    <div><dt>Cleared date</dt><dd>@(transaction.ClearedDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd></div>
                    <div><dt>Status</dt><dd>@transaction.TransactionStatus</dd></div>
                    <div><dt>Original payment reference</dt><dd>@(transaction.OriginalPaymentReference ?? "—")</dd></div>
                    <div><dt>Payment reference</dt><dd>@transaction.PaymentReference</dd></div>
                    <div><dt>Aggregated payment URN</dt><dd>@(transaction.AggregatedPaymentURN ?? "—")</dd></div>
                    <div><dt>Liberata notified date</dt><dd>@(transaction.LiberataNotifiedDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd></div>
                    <div><dt>Liberata notified aggregated payment date</dt><dd>@(transaction.LiberataNotifiedAggregatedPaymentDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd></div>
                    <div><dt>Barclaycard transaction ID</dt><dd>@(transaction.BarclaycardTransactionId ?? "—")</dd></div>
                    <div><dt>Last 4 digits</dt><dd>@(transaction.Last4DigitsCard ?? "—")</dd></div>
                    <div><dt>Notes</dt><dd>@(transaction.Notes ?? "—")</dd></div>
                    <div><dt>Expected date</dt><dd>@(transaction.ExpectedDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd></div>
                    <div><dt>Referring transaction ID</dt><dd>@(transaction.ReferringTransactionId?.ToString() ?? "—")</dd></div>
                </dl>
            </article>
        }
        </div>
    }
</section>
