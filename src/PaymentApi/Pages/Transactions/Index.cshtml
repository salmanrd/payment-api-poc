@page "/transactions"
@model PaymentApi.Pages.Transactions.IndexModel
@{
    ViewData["Title"] = "Transactions";
}

<h1>Transactions</h1>

<form method="get" class="filters" role="search">
    <div class="form-group search-group">
        <label asp-for="CaseNo">Search by case number</label>
        <div class="search-row">
            <input asp-for="CaseNo" type="search" />
            <button type="submit">Search</button>
        </div>
        <div class="hint">Enter all or part of a case number or CCD case number</div>
    </div>
</form>

<section class="transaction-section" aria-labelledby="transactions-heading">
    <div class="transaction-heading">
        <h2 id="transactions-heading">Transaction data</h2>
        @if (Model.Transactions.Count > 0)
        {
            <div class="view-toggle">
                <span id="view-toggle-label">Display as</span>
                <div class="view-toggle-options" role="group" aria-labelledby="view-toggle-label">
                    <button type="button" class="view-toggle-button is-selected" data-view="cards" aria-pressed="true">Cards</button>
                    <button type="button" class="view-toggle-button" data-view="table" aria-pressed="false">Table</button>
                </div>
            </div>
        }
    </div>
    @if (Model.Transactions.Count == 0)
    {
        <p>No transactions found.</p>
    }
    else
    {
        <div class="transaction-list">
        @foreach (var transaction in Model.Transactions)
        {
            <article class="transaction-card">
                <h3>Transaction @transaction.TransactionId</h3>
                <dl class="transaction-details">
                    <div><dt>Case number</dt><dd>@transaction.CaseNo</dd></div>
                    <div><dt>CCD case number</dt><dd>@transaction.CcdCaseNumber</dd></div>
                    <div><dt>Type</dt><dd>@transaction.TransactionType</dd></div>
                    <div><dt>Method</dt><dd>@transaction.TransactionMethod</dd></div>
                    <div><dt>Date</dt><dd>@transaction.TransactionDate.ToString("dd MMM yyyy HH:mm")</dd></div>
                    <div><dt>Amount</dt><dd>@transaction.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-GB"))</dd></div>
                    <div><dt>Cleared date</dt><dd>@(transaction.ClearedDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd></div>
                    <div><dt>Status</dt><dd>@transaction.TransactionStatus</dd></div>
                    <div><dt>Original payment reference</dt><dd>@(transaction.OriginalPaymentReference ?? "—")</dd></div>
                    <div><dt>Payment reference</dt><dd>@transaction.PaymentReference</dd></div>
                    <div><dt>Aggregated payment URN</dt><dd>@(transaction.AggregatedPaymentURN ?? "—")</dd></div>
                    <div><dt>Liberata notified date</dt><dd>@(transaction.LiberataNotifiedDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd></div>
                    <div><dt>Liberata notified aggregated payment date</dt><dd>@(transaction.LiberataNotifiedAggregatedPaymentDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd></div>
                    <div><dt>Barclaycard transaction ID</dt><dd>@(transaction.BarclaycardTransactionId ?? "—")</dd></div>
                    <div><dt>Last 4 digits</dt><dd>@(transaction.Last4DigitsCard ?? "—")</dd></div>
                    <div><dt>Notes</dt><dd>@(transaction.Notes ?? "—")</dd></div>
                    <div><dt>Expected date</dt><dd>@(transaction.ExpectedDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd></div>
                    <div><dt>Referring transaction ID</dt><dd>@(transaction.ReferringTransactionId?.ToString() ?? "—")</dd></div>
                </dl>
            </article>
        }
        </div>

        <div class="transaction-table-view table-scroll" hidden>
            <table class="transaction-table">
                <caption class="visually-hidden">Transactions in tabular format</caption>
                <thead>
                    <tr>
                        <th scope="col">Transaction ID</th>
                        <th scope="col">Case number</th>
                        <th scope="col">CCD case number</th>
                        <th scope="col">Type</th>
                        <th scope="col">Method</th>
                        <th scope="col">Date</th>
                        <th scope="col" class="numeric">Amount</th>
                        <th scope="col">Cleared date</th>
                        <th scope="col">Status</th>
                        <th scope="col">Original payment reference</th>
                        <th scope="col">Payment reference</th>
                        <th scope="col">Aggregated payment URN</th>
                        <th scope="col">Liberata notified date</th>
                        <th scope="col">Liberata notified aggregated payment date</th>
                        <th scope="col">Barclaycard transaction ID</th>
                        <th scope="col">Last 4 digits</th>
                        <th scope="col">Notes</th>
                        <th scope="col">Expected date</th>
                        <th scope="col">Referring transaction ID</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var transaction in Model.Transactions)
                {
                    <tr>
                        <td>@transaction.TransactionId</td>
                        <td>@transaction.CaseNo</td>
                        <td>@transaction.CcdCaseNumber</td>
                        <td>@transaction.TransactionType</td>
                        <td>@transaction.TransactionMethod</td>
                        <td>@transaction.TransactionDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td class="numeric">@transaction.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-GB"))</td>
                        <td>@(transaction.ClearedDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                        <td>@transaction.TransactionStatus</td>
                        <td>@(transaction.OriginalPaymentReference ?? "—")</td>
                        <td>@transaction.PaymentReference</td>
                        <td>@(transaction.AggregatedPaymentURN ?? "—")</td>
                        <td>@(transaction.LiberataNotifiedDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                        <td>@(transaction.LiberataNotifiedAggregatedPaymentDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                        <td>@(transaction.BarclaycardTransactionId ?? "—")</td>
                        <td>@(transaction.Last4DigitsCard ?? "—")</td>
                        <td>@(transaction.Notes ?? "—")</td>
                        <td>@(transaction.ExpectedDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                        <td>@(transaction.ReferringTransactionId?.ToString() ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<script src="~/js/transaction-view-toggle.js" asp-append-version="true" defer></script>
